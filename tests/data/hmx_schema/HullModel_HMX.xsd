                                <xs:documentation>Zero if key coil is not used.</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
            <xs:attribute name="CompId" type="xs:string" use="required" />
            <xs:attribute name="Info" type="xs:string" use="optional">
