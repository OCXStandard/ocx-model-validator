                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="Ppv" type="xs:double" />
        </xs:complexType>
    </xs:element>
    <xs:complexType name="MaterialDataDataType">
        <xs:attribute name="E" type="xs:double">
            <xs:annotation>
                <xs:documentation>Modulus of elasticity [N/mm^2]</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="SigmaFBott" type="xs:double">
            <xs:annotation>
                <xs:documentation>Yield point [n/mm^2] at bottom.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="SigmaFDeck" type="xs:double">
            <xs:annotation>
                <xs:documentation>Yield point [n/mm^2] at deck.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
