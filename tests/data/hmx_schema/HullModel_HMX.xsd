<xs:schema xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" attributeFormDefault="unqualified" elementFormDefault="qualified" vc:minVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="CrossSection_2DLX.xsd" />
    <xs:element name="HullModel">
        <xs:annotation>
            <xs:documentation>Hull model for calculations</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ShipData">
                    <xs:complexType>
                        <xs:choice>
                            <xs:element name="CSR-H" type="CSR-HType" />
                            <xs:element name="RV5" type="RV5Type" />
                            <xs:element name="DNV" type="DNVType" />
                        </xs:choice>
                        <xs:attribute name="VesselId" type="xs:string" use="required" />
                        <xs:attribute name="ShipType" type="VesselType" use="required" />
                        <xs:attribute name="Info" />
                    </xs:complexType>
                </xs:element>
                <xs:element name="FrameTable">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Spacing" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="FrameNo" type="xs:string" use="required">
                                        <xs:annotation>
                                            <xs:documentation>First spacing should have 'Stern' spesified. Consecutive entries should have frame number from where the new spacing is valid.</xs:documentation>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="Spacing" use="required">
                                        <xs:annotation>
                                            <xs:documentation>Frame spacing in meter.</xs:documentation>
                                        </xs:annotation>
                                        <xs:simpleType>
                                            <xs:restriction base="xs:decimal">
                                                <xs:minExclusive value="0.0" />
                                                <xs:maxExclusive value="200.0" />
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="FrameOffset" default="0.0" type="xs:double">
                            <xs:annotation>
                                <xs:documentation>Distance between frame 0 and AP (or FP) [m].</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="FrameRef" use="required">
                            <xs:annotation>
                                <xs:documentation>Frame 0 reference point.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="AP" />
                                    <xs:enumeration value="FP" />
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="GlobalData" type="GlobalElements" minOccurs="0" maxOccurs="1" />
                <xs:element name="GirderPositions" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:sequence minOccurs="1" maxOccurs="unbounded">
                            <xs:element name="GirderPosition">
                                <xs:complexType>
                                    <xs:attribute name="FrameNo" type="xs:string" />
                                    <xs:attribute name="HasWebframe" type="xs:boolean" />
                                    <xs:attribute name="HasBulkhead" type="xs:boolean" />
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Loads" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="LoadCondition" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element ref="CompLoad" minOccurs="0" maxOccurs="unbounded" />
                                    </xs:sequence>
                                    <xs:attribute name="Name" type="xs:string" use="required" />
                                    <xs:attribute name="ConditionType" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="Prescriptive" />
                                                <xs:enumeration value="Fatigue" />
                                                <xs:enumeration value="Flooding" />
                                                <xs:enumeration value="Undefined" />
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                    <xs:attribute name="LoadingType" use="required">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="Homogeneous" />
                                                <xs:enumeration value="Alternate" />
                                                <xs:enumeration value="Ballast" />
                                                <xs:enumeration value="Heavy ballast" />
                                                <xs:enumeration value="Steel coil" />
                                                <xs:enumeration value="FullLoad" />
                                                <xs:enumeration value="Undefined" />
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                    <xs:attribute name="FillingOfHolds" use="optional">
                                        <xs:simpleType>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="Fully filled" />
                                                <xs:enumeration value="Partly filled" />
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                    <xs:attribute name="Draught" type="xs:double" use="required" />
                                    <xs:attribute name="Kr" type="xs:double" use="required" />
                                    <xs:attribute name="GM" type="xs:double" use="required" />
                                    <xs:attribute name="HeelAngle" type="xs:double" use="optional" />
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Compartments" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element ref="Compartment" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="CrossSections">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Scantling" type="Section2DLX" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="MomentsAndShearForces" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="MomentAndShearForceCurves" type="MomentAndShearForceCurves" minOccurs="1" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="HighestPointsInHeel">
        <xs:sequence>
            <xs:element name="AftEnd">
                <xs:complexType>
                    <xs:attribute name="X" type="xs:int" use="required" />
                    <xs:attribute name="PortY" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="PortZ" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="StbY" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="StbZ" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <!--<xs:attribute name="ServiceRestriction" type="RestrictedServiceTypes"/>-->
                </xs:complexType>
            </xs:element>
            <xs:element name="FwdEnd">
                <xs:complexType>
                    <xs:attribute name="X" type="xs:int" use="required" />
                    <xs:attribute name="PortY" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="PortZ" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="StbY" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="StbZ" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:int" />
                        </xs:simpleType>
                    </xs:attribute>
                    <!--<xs:attribute name="ServiceRestriction" type="RestrictedServiceTypes"/>-->
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DNVType">
        <xs:sequence>
            <xs:element name="ApplicableRules" type="ApplicableRulesDNVType" />
            <xs:element name="MainDimensions" type="MainDimensionsType" />
            <xs:element name="GeneralShipDataType" type="GeneralShipDataType" />
            <xs:element name="MaterialData" type="MaterialDataDataType" />
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="RuleSet">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DNV-1A1" />
            <xs:enumeration value="CSR-Harmonized" />
            <xs:enumeration value="RV5" />
            <xs:enumeration value="Other" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="VesselType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Bulk carrier" />
