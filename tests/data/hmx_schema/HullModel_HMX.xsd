            <xs:enumeration value="Ore carrier" />
            <xs:enumeration value="Container carrier" />
            <xs:enumeration value="High speed light craft" />
            <xs:enumeration value="FPSO" />
            <xs:enumeration value="Offshore supply vessel" />
            <xs:enumeration value="Other" />
            <xs:enumeration value="MPV" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="BulkNotation">
        <xs:restriction base="xs:string">
            <xs:enumeration value="BC-A" />
            <xs:enumeration value="BC-B" />
            <xs:enumeration value="BC-C" />
            <xs:enumeration value="BC-B*" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="TankNotation">
        <xs:restriction base="xs:string">
            <xs:enumeration value="oil" />
            <xs:enumeration value="oil product" />
            <xs:enumeration value="chemicals" />
            <xs:enumeration value="chemicals and oil" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="RestrictedServiceTypes">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none" />
            <xs:enumeration value="R0" />
            <xs:enumeration value="R1" />
            <xs:enumeration value="R2" />
            <xs:enumeration value="R3" />
            <xs:enumeration value="R4" />
            <xs:enumeration value="RE" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="FreeboardType">
        <xs:annotation>
            <xs:documentation> Freeboard Type. A=1, B=2, B60=3, B100=4</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="A" />
            <xs:enumeration value="B" />
            <xs:enumeration value="B60" />
            <xs:enumeration value="B100" />
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="HatchData">
        <xs:attribute name="Breadth" type="xs:double" />
        <xs:attribute name="Length" type="xs:double" />
        <xs:attribute name="TopOfHatch" type="xs:double">
            <xs:annotation>
                <xs:documentation>Top of hatch from BL [m]</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="SloshingData">
        <xs:attribute name="FillingHeight" type="xs:double">
            <xs:annotation>
                <xs:documentation>Filling height from BL, sloshing (mm)</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="Breadth" type="xs:double" />
        <xs:attribute name="Length" type="xs:double" />
        <xs:attribute name="Density" type="xs:double">
            <xs:annotation>
                <xs:documentation>Liquid density, sloshing. [t/m3]</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="BoundaryData">
        <xs:attribute name="MinX" type="xs:double" use="required" />
        <xs:attribute name="MaxX" type="xs:double" use="required" />
        <xs:attribute name="MinY" type="xs:double" use="required" />
        <xs:attribute name="MaxY" type="xs:double" use="required" />
        <xs:attribute name="MinZ" type="xs:double" use="required" />
        <xs:attribute name="MaxZ" type="xs:double" use="required" />
    </xs:complexType>
    <xs:element name="Compartment">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="General">
                    <xs:complexType>
                        <xs:attribute name="TopOfFlowThroughBWE" type="xs:double" />
                        <xs:attribute name="HoldNo" type="xs:int" />
                        <xs:attribute name="Length" type="xs:int" />
                        <xs:attribute name="TopOfAirPipe" type="xs:int" />
                        <xs:attribute name="Volume" type="xs:double" />
                        <xs:attribute name="CgX" type="xs:int">
                            <xs:annotation>
                                <xs:documentation>Centre of gravity distance from AP in mm.</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="CgY" type="xs:int">
                            <xs:annotation>
                                <xs:documentation>Centre of gravity distance from CL in mm.</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="CgZ" type="xs:int">
                            <xs:annotation>
                                <xs:documentation>Centre of gravity distance from BL in mm.</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="FreeSurfaceY" type="xs:int">
                            <xs:annotation>
                                <xs:documentation>Free surface from CL in mm.</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="IsHeated" default="false" type="xs:boolean">
                            <xs:annotation>
                                <xs:documentation>Heated cargo/fuel oil tank</xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="BallastWaterExchangeByFlowThrough" type="xs:boolean" />
                        <xs:attribute name="VesselArea">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="CargoArea" />
                                    <xs:enumeration value="ForwardPart" />
                                    <xs:enumeration value="AftPart" />
                                    <xs:enumeration value="MachinerySpace" />
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:choice>
                    <xs:element name="RV5" type="RV5_CompartmentData" />
                    <xs:element name="CSRH" type="CSRH_CompartmentData" />
                </xs:choice>
                <xs:element name="Hatch" type="HatchData" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Only for Bulk</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="Geometry">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="BoundingBox" type="BoundaryData" />
                            <xs:element name="HighestPointsInHeel" type="HighestPointsInHeel" minOccurs="0" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="Name" type="xs:string" use="required" />
            <xs:attribute name="Type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="Undefined" />
                        <xs:enumeration value="BallastWaterTank" />
                        <xs:enumeration value="DryBulkCargoHold" />
                        <xs:enumeration value="OilCargoTank" />
                        <xs:enumeration value="FuelOilTank" />
                        <xs:enumeration value="FreshWaterTank" />
                        <xs:enumeration value="VoidSpace" />
                        <xs:enumeration value="DrySpace" />
                        <xs:enumeration value="PipeTunnel" />
                        <xs:enumeration value="LubricationOilTank" />
                        <xs:enumeration value="Hold" />
                        <xs:enumeration value="MachinerySpace" />
                        <xs:enumeration value="External" />
                        <xs:enumeration value="CellularContainerHold" />
                        <xs:enumeration value="ChainLocker" />
                        <xs:enumeration value="Accommodation" />
                        <xs:enumeration value="LiquidChemicalsTank" />
                        <xs:enumeration value="LiquefiedGasTank" />
                        <xs:enumeration value="BrineTank" />
                        <xs:enumeration value="UreaTank" />
                        <xs:enumeration value="RSWTank" />
                        <xs:enumeration value="CargoHold" />
                        <xs:enumeration value="SpaceContainingIdependentCargoTanks" />
                        <xs:enumeration value="BilgeTank" />
                        <xs:enumeration value="DrainStorageTank" />
                        <xs:enumeration value="IndependentLiquefiedGasTank" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="Id" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>
    <xs:element name="CompLoad">
        <xs:complexType>
            <xs:choice>
                <xs:element name="WaterBallast">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="BulkCargo">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="AngleOfResponse" type="xs:double" use="required" />
                        <xs:attribute name="Permeability" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
