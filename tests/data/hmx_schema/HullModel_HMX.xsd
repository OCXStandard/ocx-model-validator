                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="HeavyFuelOil">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="LubeOil">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="OilCargo">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="LiquidCargo">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="HeavyLiquid">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="FreshWater">
                    <xs:complexType>
                        <xs:attribute name="Density" type="xs:double" use="required" />
                        <xs:attribute name="FillingHeight" type="xs:double" use="required">
                            <xs:annotation>
                                <xs:documentation>Filling height from base line (BL) in millimeters. </xs:documentation>
                            </xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Flooded">
