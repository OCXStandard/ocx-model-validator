    <unitsml:DimensionSet>
        <unitsml:Dimension xml:id="ID_F" dimensionless="false">
            <unitsml:Length symbol="L" powerNumerator="1"/>
            <unitsml:Mass symbol="M" powerNumerator="1"/>
            <unitsml:Time symbol="T" powerNumerator="1"/>
            <unitsml:ElectricCurrent symbol="I" powerNumerator="1"/>
            <unitsml:AmountOfSubstance symbol="N" powerNumerator="1"/>
