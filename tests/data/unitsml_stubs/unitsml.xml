            <unitsml:UnitSymbol type="m"/>
        </unitsml:Unit>
        <unitsml:Unit xml:id="u2" dimensionURL="ID2">
            <unitsml:UnitName xml:lang="en-us">millimeter</unitsml:UnitName>
            <unitsml:UnitSymbol type="mm"/>
