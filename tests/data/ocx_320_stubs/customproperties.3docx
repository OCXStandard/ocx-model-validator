<ocx:CustomProperties xmlns:ocx="https://3docx.org/fileadmin//ocx_schema//V320//OCX_Schema.xsd">
    <ocx:CustomProperty id="cprop_2328" name="derivedThickness" value="penetratedPlate">
        <ocx:Description>Thickness inherited from the penetrated plate, not authored: the Modeler's lug plates carry none, and LugPlateRef requires a real Plate that does.</ocx:Description>
    </ocx:CustomProperty>
    <ocx:CustomProperty id="cprop_2329" name="derivedMaterial" value="penetratedPlate">
        <ocx:Description>Material inherited from the penetrated plate, not authored.</ocx:Description>
    </ocx:CustomProperty>
</ocx:CustomProperties>
